# Security headers (all paths)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: unload=()

# Hashed Next.js bundles — long cache, no overlap with /*
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images and static media
/images/*
  Cache-Control: public, max-age=604800

/hero-bg.jpg
  Cache-Control: public, max-age=604800

/hero-bg.webp
  Cache-Control: public, max-age=604800

/*.webp
  Cache-Control: public, max-age=604800

/og-default.jpg
  Cache-Control: public, max-age=604800

# Crawler files — single Cache-Control only (do NOT also match a /* cache rule)
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400

/sitemap_index.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=86400

# Bing IndexNow key verification
/83d2fecd2b67485c9292249d3d936875.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400
