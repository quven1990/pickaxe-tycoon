# Copy to .env.local and fill in values. Never commit .env.local or JSON keys.
# Setup guide: docs/OPS-ANALYTICS.md

OPS_SITE_DOMAIN=pickaxe-tycoon.xyz

# --- Plausible (shipsolo instance) ---
# Plausible → Account Settings → API keys → Stats API
PLAUSIBLE_BASE_URL=https://plausible.shipsolo.io
PLAUSIBLE_API_KEY=

# --- Google (one service account for GA4 + GSC) ---
# Path relative to project root, e.g. credentials/google-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=credentials/google-service-account.json
# GA4 → Admin → Property settings → Property ID (numeric only)
GA4_PROPERTY_ID=
# GSC property URL: sc-domain:pickaxe-tycoon.xyz OR https://pickaxe-tycoon.xyz/
GSC_SITE_URL=sc-domain:pickaxe-tycoon.xyz

# --- Bing Webmaster ---
# Bing Webmaster → Settings → API Access → API Key
BING_WEBMASTER_API_KEY=
BING_SITE_URL=https://pickaxe-tycoon.xyz/
